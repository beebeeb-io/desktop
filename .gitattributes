# Rust source is LF on every checkout, a Windows one with core.autocrlf included: the source guards read it as text
# (`include_str!`, `read_to_string`) and look for "\n", so a CRLF checkout turned them red (v2 W2, R1r).
*.rs text eol=lf

# Fixture bytes are test oracles: never rewrite line endings on add or checkout.
# Use -text (rather than binary) so textual fixtures retain readable diffs.
fixtures/** -text
tests/fixtures/** -text
