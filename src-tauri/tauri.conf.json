{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beebeeb",
  "version": "0.1.0",
  "identifier": "io.beebeeb.desktop",
  "build": {
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beebeeb",
        "url": "https://app.beebeeb.io",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.beebeeb.io/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NUQ3QkE3N0VERUE3RTEKUldUaHA5NStwM3RkVkkzaW50Z0dmVGhNQkxzakN0bENGN2VWMGhUWTQ3OFNNMUJvTEt3VTRGbDQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted cloud storage. Made in Europe.",
    "longDescription": "Beebeeb is end-to-end encrypted, zero-knowledge cloud storage. Files are encrypted on your device before they leave your machine. Operated by Initlabs B.V., Wijchen, Netherlands."
  }
}
