{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beebeeb",
  "version": "0.1.0",
  "identifier": "io.beebeeb.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Beebeeb",
        "url": "index.html",
        "width": 680,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.beebeeb.io/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NUQ3QkE3N0VERUE3RTEKUldUaHA5NStwM3RkVkkzaW50Z0dmVGhNQkxzakN0bENGN2VWMGhUWTQ3OFNNMUJvTEt3VTRGbDQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted cloud storage. Made in Europe.",
    "longDescription": "Beebeeb is end-to-end encrypted, zero-knowledge cloud storage. Files are encrypted on your device before they leave your machine. Operated by Initlabs B.V., Wijchen, Netherlands.",
    "macOS": {
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "providerShortName": null
    }
  }
}
