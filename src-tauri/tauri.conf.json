{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beebeeb",
  "version": "0.1.0",
  "identifier": "io.beebeeb.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beebeeb",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted cloud storage. Made in Europe.",
    "longDescription": "Beebeeb is end-to-end encrypted, zero-knowledge cloud storage. Files are encrypted on your device before they leave your machine. Operated by Initlabs B.V., Wijchen, Netherlands."
  }
}
