{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beebeeb",
  "version": "0.1.0",
  "identifier": "io.beebeeb.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "node scripts/before-bundle.mjs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "tray",
        "title": "Beebeeb",
        "url": "index.html?window=tray",
        "width": 400,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "windows-onboarding",
        "title": "Welcome to Beebeeb",
        "url": "index.html?window=onboarding&platform=windows",
        "width": 720,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true
      },
      {
        "label": "main-app",
        "title": "Beebeeb",
        "url": "index.html?window=main-app&platform=windows",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.beebeeb.io https://releases.beebeeb.io; img-src 'self' blob: data:; font-src 'self'"
    },
    "trayIcon": {
      "id": "tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.beebeeb.io/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2RkFERkQ1OUQ3MzIxOTcKUldTWElYT2QxZC82eG1ocjBUK0ZUZUZqU25JbmFNdmJoZ0w1dnhidDUxREZMd2wycUlDOGpVNloK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted cloud storage. Made in Europe.",
    "longDescription": "Beebeeb is end-to-end encrypted, zero-knowledge cloud storage. Files are encrypted on your device before they leave your machine. Operated by Initlabs B.V., Wijchen, Netherlands.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "files": {
        "embedded.provisionprofile": "target/profiles/BeebeebApp.provisionprofile",
        "PlugIns/BeebeebFileProvider.appex": "target/fileprovider/BeebeebFileProvider.appex",
        "MacOS/BeebeebFileProviderCtl": "target/fileprovider/BeebeebFileProviderCtl"
      },
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "providerShortName": null
    }
  }
}
