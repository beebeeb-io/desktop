{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@beebeeb/shared/design": [
        "packages/shared/src/design/index.ts"
      ],
      "@beebeeb/shared/drive-ui": [
        "packages/shared/src/drive-ui/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/shared/src/design",
    "packages/shared/src/drive-ui"
  ]
}
