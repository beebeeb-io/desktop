<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for the BeebeebFileProvider extension target.

  Spec: docs/superpowers/plans/2026-05-07-desktop-sync-client.md Phase 2 Task 5.

  Wired into Xcode by:
    1. Adding "BeebeebFileProvider" as a File Provider Extension target
    2. Pointing its Info.plist build setting at this file
    3. Setting the bundle identifier to io.beebeeb.app.FileProvider
       (parent app + ".FileProvider" suffix per Apple's convention)
    4. Setting deployment target — see scaffold notes in
       FileProviderItem.swift / FileProviderExtension.swift

  The CFBundleVersion / CFBundleShortVersionString are deliberately the
  same as the parent app's so the extension is signed and updated as a
  unit. Keep the bundle id paired with the stable domain identifier in
  src-tauri/macos/FileProviderBridge.m (BeebeebDomainIdentifier; the Swift
  DomainRegistration.swift was retired in task 1697); changing either
  after public release needs a Finder-domain migration plan.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Beebeeb File Provider</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!--
      Extension declaration. NSExtensionPointIdentifier tells macOS
      which extension point this binary plugs into; the principal
      class is the Swift class that gets instantiated when Finder
      asks for an item.
    -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>R8352WDJJR.io.beebeeb.app.fileprovider</string>
		<!--
		  NSExtensionFileProviderAppliesChangesAtomically is deliberately
		  NOT declared (task 1699). The write queue converges changes
		  server-side asynchronously: a crash mid-upload leaves the item
		  row in a partially-converged "uploading" state, and the 1684
		  idempotency keys make retries safe but not atomic. Staging is
		  atomic (tmp+rename), but that protects the content handoff, not
		  change application. Declaring this key would promise the system
		  batch-atomic application we cannot guarantee, so we omit it.
		-->
		<!--
		  Sync-state badges (task 1699). Identifiers match
		  BeebeebProviderItem.decorationIdentifier(forStatus:) in
		  FileProviderItem.swift; BadgeImageType UTIs are declared under
		  UTImportedTypeDeclarations below and resolve to icon files in
		  Contents/Resources (badge-*.png). Category "Badge": macOS renders
		  at most the FIRST badge per item, so FileProviderItem maps each
		  status to exactly one decoration (priority: error > conflict >
		  trashing > uploading > downloading).
		-->
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>io.beebeeb.app.decoration.error</string>
				<key>BadgeImageType</key>
				<string>io.beebeeb.app.badge.error</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Sync problem</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>io.beebeeb.app.decoration.conflict</string>
				<key>BadgeImageType</key>
				<string>io.beebeeb.app.badge.conflict</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Conflicted copy</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>io.beebeeb.app.decoration.trashing</string>
				<key>BadgeImageType</key>
				<string>io.beebeeb.app.badge.trashing</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Moving to Trash</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>io.beebeeb.app.decoration.uploading</string>
				<key>BadgeImageType</key>
				<string>io.beebeeb.app.badge.uploading</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Uploading</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>io.beebeeb.app.decoration.downloading</string>
				<key>BadgeImageType</key>
				<string>io.beebeeb.app.badge.downloading</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Downloading</string>
			</dict>
		</array>
		<key>NSExtensionFileProviderDownloadPipelineDepth</key>
		<integer>8</integer>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionFileProviderUploadPipelineDepth</key>
		<integer>8</integer>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
	</dict>

    <!--
      Badge icon types (task 1699). Each decoration's BadgeImageType
      resolves to one of these imported UTIs; UTTypeIconFile names the
      PNG shipped in Contents/Resources by
      scripts/build-fileprovider-extension.sh. Conforming to
      com.apple.icon-decoration.badge is what lets the system look the
      icon up at render time. These are generated placeholder icons
      (flat circle, deterministic bytes) pending a design pass.
    -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.beebeeb.app.badge.error</string>
            <key>UTTypeDescription</key>
            <string>Beebeeb sync-problem badge</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.icon-decoration.badge</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>badge-error</string>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.beebeeb.app.badge.conflict</string>
            <key>UTTypeDescription</key>
            <string>Beebeeb conflicted-copy badge</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.icon-decoration.badge</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>badge-conflict</string>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.beebeeb.app.badge.trashing</string>
            <key>UTTypeDescription</key>
            <string>Beebeeb moving-to-trash badge</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.icon-decoration.badge</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>badge-trashing</string>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.beebeeb.app.badge.uploading</string>
            <key>UTTypeDescription</key>
            <string>Beebeeb uploading badge</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.icon-decoration.badge</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>badge-uploading</string>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.beebeeb.app.badge.downloading</string>
            <key>UTTypeDescription</key>
            <string>Beebeeb downloading badge</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.icon-decoration.badge</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>badge-downloading</string>
        </dict>
    </array>

    <!--
      Shown to the user when macOS first asks them to grant the
      File Provider domain. Keep brand voice ("encrypted", not
      "secure"; "Finder" capitalised because it's the product
      name).
    -->
    <key>NSFileProviderDomainUsageDescription</key>
    <string>Beebeeb uses this to sync your encrypted files in Finder.</string>
</dict>
</plist>
